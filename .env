# ─── Datenbank ───────────────────────────────────────────────
DATABASE_URL="postgresql://campusbudget:campusbudget@localhost:5432/campusbudget?schema=public"

# ─── App ─────────────────────────────────────────────────────
# Öffentliche Basis-URL ohne abschließenden Slash
APP_URL="http://localhost:3000"
# Auth.js – erzeugen mit: npx auth secret  oder  openssl rand -base64 32
AUTH_SECRET="HJKvY8Oqq78X0Ez1Kj8SWib+X11ssgzFz4AnkSp6slQ="
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth (optional – der Button erscheint nur, wenn beide Werte gesetzt sind)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 32-Byte-Schlüssel (Base64) für die Verschlüsselung der 2FA-Secrets: openssl rand -base64 32
ENCRYPTION_KEY="3i8hoP/CgziuSroPwBAQTFIxsrZ0yOd/Fj5A+UnH5Kc="

# ─── E-Mail (Resend) ────────────────────────────────────────
# Ohne API-Key werden E-Mails in der Server-Konsole ausgegeben (Entwicklung).
RESEND_API_KEY=""
EMAIL_FROM="CampusBudget <noreply@example.com>"

# ─── Cron ────────────────────────────────────────────────────
# Geheimnis für /api/cron/daily (Header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="901795df4857e1e3bede44e691006034a3f918a44f9eda0a"

# ─── Datei-Uploads ───────────────────────────────────────────
# "local" (Dateisystem / Docker-Volume) oder "s3" (AWS S3, Cloudflare R2, MinIO …)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Analytics (optional, wird nur nach Cookie-Einwilligung geladen) ───
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_HOST=""

# Lokales Test-Postfach Mailpit (http://localhost:8025). Für echte Zustellung z. B. Gmail eintragen:
