# ─── Datenbank ───────────────────────────────────────────────
DATABASE_URL="postgresql://campusbudget:campusbudget@localhost:5432/campusbudget?schema=public"

# ─── App ─────────────────────────────────────────────────────
# Öffentliche Basis-URL ohne abschließenden Slash
APP_URL="http://localhost:3000"
# Auth.js – erzeugen mit: npx auth secret  oder  openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth (optional – der Button erscheint nur, wenn beide Werte gesetzt sind)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 32-Byte-Schlüssel (Base64) für die Verschlüsselung der 2FA-Secrets: openssl rand -base64 32
ENCRYPTION_KEY=""

# ─── E-Mail ──────────────────────────────────────────────────
# Reihenfolge: RESEND_API_KEY → SMTP_HOST → Ausgabe in der Server-Konsole.
EMAIL_FROM="CampusBudget <noreply@example.com>"

# Option A: Resend (https://resend.com) – ohne verifizierte Domain nur an die eigene Adresse
RESEND_API_KEY=""

# Option B: SMTP, z. B. Gmail mit App-Passwort (EMAIL_FROM = deine Gmail-Adresse):
#   SMTP_HOST="smtp.gmail.com"  SMTP_PORT="465"  SMTP_USER="du@gmail.com"  SMTP_PASSWORD="<App-Passwort>"
# Lokales Test-Postfach Mailpit (startet mit `npm run dev`, Ansicht: http://localhost:8025):
#   SMTP_HOST="127.0.0.1"  SMTP_PORT="1025"   (nicht "localhost" – das wird teils als IPv6 aufgelöst)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ─── Cron ────────────────────────────────────────────────────
# Geheimnis für /api/cron/daily (Header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# ─── Datei-Uploads ───────────────────────────────────────────
# "local" (Dateisystem / Docker-Volume) oder "s3" (AWS S3, Cloudflare R2, MinIO …)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Analytics (optional, wird nur nach Cookie-Einwilligung geladen) ───
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_HOST=""
